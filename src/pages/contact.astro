---
import NavRow from '@/components/NavRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCv } from '@/lib/cv';
import { formatContactRows } from '@/lib/cv-format';
import { enterClass } from '@/lib/entrance';
import { pageMeta } from '@/lib/site-meta';

// Spec 0011: the heading, then one keyed row per channel inside an <address>,
// email first, then each profile in cv.json order. No intro, no form, no
// script. The head comes from the `contact` row (spec 0006). Spec 0016: the
// heading, then each row, then the footer enter in order.
const cv = await getCv();
const rows = formatContactRows(cv.basics);
---

<BaseLayout
  {...pageMeta('contact', cv, Astro.site)}
  footerStep={rows.length + 1}
>
  <div class="flex flex-col gap-6">
    <h1 class:list={['text-lg font-medium', enterClass(0)]}>contact</h1>
    <address class="not-italic">
      <ul class="flex flex-col gap-1">
        {rows.map((row, index) => (
          <NavRow
            kind="key"
            href={row.href}
            prefix={row.key}
            label={row.label}
            class={enterClass(index + 1)}
          />
        ))}
      </ul>
    </address>
  </div>
</BaseLayout>
