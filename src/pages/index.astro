---
import NavRow from '@/components/NavRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCv } from '@/lib/cv';
import { pageMeta } from '@/lib/site-meta';
import { formatRowNumber, SITE_NAV } from '@/lib/site-nav';

// Spec 0008: the name, the muted tagline, and the pages that exist as numbered
// rows, centred in the page by the layout. The bio stays in the head as the
// description, and the links live on /contact. No avatar, no motion, no
// script. The head comes from the `home` row (spec 0006).
const cv = await getCv();
const { basics } = cv;
---

<BaseLayout {...pageMeta('home', cv, Astro.site)} centered>
  <header class="flex flex-col gap-2">
    <h1 class="text-title font-medium">{basics.name}</h1>
    <p class="text-pretty text-muted">{basics.tagline}</p>
  </header>
  <nav aria-label="Pages">
    <ol class="flex flex-col gap-1">
      {SITE_NAV.map(({ label, href }, index) => (
        <NavRow
          kind="number"
          href={href}
          prefix={formatRowNumber(index)}
          label={label}
        />
      ))}
    </ol>
  </nav>
</BaseLayout>
