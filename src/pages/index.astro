---
import NavRow from '@/components/NavRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCv } from '@/lib/cv';
import { formatProfileHandle } from '@/lib/cv-format';
import { pageMeta } from '@/lib/site-meta';
import { formatRowNumber, SITE_NAV } from '@/lib/site-nav';

// Spec 0004: the name, the bio, the pages that exist as numbered rows, and the
// profiles and email as keyed rows. No avatar, no motion, no script. The head
// comes from the `home` row (spec 0006).
const cv = await getCv();
const { basics } = cv;
const profiles = basics.profiles ?? [];
---

<BaseLayout {...pageMeta('home', cv, Astro.site)}>
  <header class="flex flex-col gap-2">
    <h1 class="text-title font-medium">{basics.name}</h1>
    <p class="text-pretty">{basics.bio}</p>
  </header>
  <nav aria-label="Pages">
    <ol class="flex flex-col gap-1">
      {SITE_NAV.map(({ label, href }, index) => (
        <NavRow
          kind="number"
          href={href}
          prefix={formatRowNumber(index)}
          label={label}
        />
      ))}
    </ol>
  </nav>
  <nav aria-label="Elsewhere">
    <ul class="flex flex-col gap-1">
      {profiles.map((profile) => (
        <NavRow
          kind="key"
          href={profile.url}
          prefix={profile.network.toLowerCase()}
          label={formatProfileHandle(profile)}
        />
      ))}
      <NavRow
        kind="key"
        href={`mailto:${basics.email}`}
        prefix="email"
        label={basics.email}
      />
    </ul>
  </nav>
</BaseLayout>
