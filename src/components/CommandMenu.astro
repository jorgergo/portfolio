---
import ArrowUpRight from '@/components/icons/ArrowUpRight.astro';
import Download from '@/components/icons/Download.astro';
import { COMMAND_MENU_ID } from '@/lib/command-menu';
import { getCv } from '@/lib/cv';
import { commandMenuGroups } from '@/lib/site-nav';

interface Props {
  // The style guide's specimen: the panel's content in a plain <div>, with no
  // ids, the field showing, the first row selected, no live region, and a
  // close button that controls nothing.
  preview?: boolean;
}

// Spec 0015: a panel near the top over the dimmed page on a fine pointer, and
// a sheet on the bottom edge with its field at the foot where touch is the
// main input. The footer and corner buttons open it through invoker commands,
// so it opens with no script. The script below adds the shortcut, the filter,
// the selected row, and the arrow keys; it never builds markup. Like
// SiteFooter, the menu reads the CV itself, so BaseLayout stays free of
// content, and routePattern (not the pathname, which is `/index.html` at
// build time) marks the current page.
const { preview = false } = Astro.props;
const { basics } = await getCv();
const groups = commandMenuGroups(basics, Astro.routePattern);
const idFor = (part: string): string | undefined =>
  preview ? undefined : `${COMMAND_MENU_ID}-${part}`;
const firstHref = groups[0]?.rows[0]?.href;
const Root = preview ? 'div' : 'dialog';
---

<Root
  id={preview ? undefined : COMMAND_MENU_ID}
  aria-labelledby={idFor('title')}
  class:list={[
    'max-w-lg rounded-xs border border-line bg-bg text-fg',
    !preview && [
      'fixed inset-x-4 top-1/7 bottom-auto m-0 mx-auto max-h-3/4 w-auto origin-top flex-col overflow-hidden overscroll-contain p-0 transition open:flex print:open:hidden',
      'backdrop:bg-scrim backdrop:transition-opacity starting:open:scale-98 starting:open:opacity-0 starting:open:backdrop:opacity-0',
      'pointer-coarse:inset-x-0 pointer-coarse:top-auto pointer-coarse:bottom-0 pointer-coarse:max-h-5/6 pointer-coarse:origin-bottom pointer-coarse:rounded-b-none pointer-coarse:border-b-0 pointer-coarse:starting:open:translate-y-2 pointer-coarse:starting:open:scale-100',
    ],
  ]}
>
  <h2 id={idFor('title')} class="sr-only">
    menu
  </h2>
  {/* The close button comes first, so a dialog the browser opens with no
  script focuses it and never the field; `order-last` shows it on the right. */}
  <div class="relative flex min-h-12 shrink-0 items-center gap-3 border-b border-line pr-4 pl-8 pointer-coarse:order-last pointer-coarse:border-t pointer-coarse:border-b-0">
    <button
      type="button"
      commandfor={preview ? undefined : COMMAND_MENU_ID}
      command={preview ? undefined : 'close'}
      class="order-last inline-flex min-h-6 items-center rounded-xs border border-line px-1.5 text-xs text-muted transition-colors hover:border-accent-warm hover:text-accent-warm focus-visible:border-accent-warm focus-visible:text-accent-warm pointer-coarse:min-h-10 pointer-coarse:border-0 pointer-coarse:px-0 pointer-coarse:text-sm"
    >
      <span class="pointer-coarse:hidden">esc</span>
      <span class="sr-only pointer-coarse:not-sr-only"> close</span>
    </button>
    {/* Not positioned, so its 2px focus line spans the whole row. */}
    <label
      hidden={!preview}
      data-menu-filter
      class="min-w-0 flex-1 after:absolute after:inset-x-0 after:-bottom-px after:h-0 after:border-t-2 after:border-accent after:opacity-0 focus-within:after:opacity-100 pointer-coarse:after:-top-px pointer-coarse:after:bottom-auto"
    >
      <span class="sr-only">search pages and links</span>
      <input
        type="text"
        placeholder="search pages and links"
        autocomplete="off"
        spellcheck="false"
        autocapitalize="off"
        enterkeyhint="go"
        class="h-12 w-full bg-transparent text-base placeholder:text-muted focus-visible:outline-none"
      />
    </label>
  </div>
  <div
    data-menu-list
    class="flex min-h-0 flex-auto flex-col gap-1 overflow-y-auto overscroll-contain p-1.5"
  >
    {groups.map(({ heading, rows }) => (
      <div data-menu-group>
        <h3 id={idFor(heading)} class="pt-2 pb-1 pl-6.5 text-xs text-muted">
          {heading}
        </h3>
        <ul aria-labelledby={idFor(heading)}>
          {rows.map((row) => (
            <li>
              <a
                href={row.href}
                download={row.download}
                aria-current={row.current ? 'page' : undefined}
                data-selected={
                  preview && row.href === firstHref ? '' : undefined
                }
                class="group flex min-h-10 flex-wrap items-center rounded-xs px-2.5 text-sm text-fg focus-visible:bg-line focus-visible:outline-none data-selected:bg-line"
              >
                <span
                  aria-hidden="true"
                  class="invisible w-4 shrink-0 group-focus-visible:visible group-data-selected:visible"
                >
                  ›
                </span>
                <span data-menu-name class="min-w-0">
                  {row.name}
                </span>
                <span class="ml-auto inline-flex items-center gap-2 pl-4 text-muted group-focus-visible:text-fg group-data-selected:text-fg">
                  {row.current ? (
                    <span aria-hidden="true">here</span>
                  ) : (
                    row.detail
                  )}
                  {row.download !== undefined ? (
                    <Download class="size-4 shrink-0" />
                  ) : (
                    row.external && <ArrowUpRight class="size-4 shrink-0" />
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p
      hidden
      aria-hidden="true"
      data-menu-empty
      class="py-2 pl-6.5 text-sm text-muted"
    >
      no match
    </p>
  </div>
  {!preview && <p class="sr-only" aria-live="polite" data-menu-status />}
</Root>

<script>
  import {
    COMMAND_MENU_ID,
    formatMatchCount,
    isComposingKey,
    isMenuShortcut,
    nextFocus,
    rowMatches,
    shortcutHint,
  } from '@/lib/command-menu';

  // An element's text without the parts hidden from assistive tech.
  const readableText = (element: Element): string =>
    element.getAttribute('aria-hidden') === 'true'
      ? ''
      : [...element.childNodes]
          .map((node) =>
            node instanceof Element
              ? readableText(node)
              : node instanceof Text
                ? node.data
                : '',
          )
          .join('');

  // A row's filter text is its link's accessible name: each child's readable
  // text joined with a space (`github @jorgergo`), so the mark, `here`, and
  // the icons never match.
  const rowText = (link: Element): string =>
    [...link.children].map(readableText).join(' ').replace(/\s+/g, ' ').trim();

  const bind = (dialog: HTMLDialogElement): void => {
    const filter = dialog.querySelector<HTMLElement>('[data-menu-filter]');
    const field = dialog.querySelector('input');
    const list = dialog.querySelector<HTMLElement>('[data-menu-list]');
    const empty = dialog.querySelector<HTMLElement>('[data-menu-empty]');
    const status = dialog.querySelector('[data-menu-status]');
    const closeButton = dialog.querySelector('button[command="close"]');
    if (
      filter === null ||
      field === null ||
      list === null ||
      empty === null ||
      status === null ||
      closeButton === null
    )
      return;

    const groups = [
      ...list.querySelectorAll<HTMLElement>('[data-menu-group]'),
    ].map((group) => ({
      group,
      rows: [...group.querySelectorAll('li')].flatMap((item) => {
        const link = item.querySelector('a');
        return link === null
          ? []
          : [
              {
                item,
                link,
                text: rowText(link),
                name:
                  link.querySelector('[data-menu-name]')?.textContent.trim() ??
                  '',
              },
            ];
      }),
    }));
    type Row = (typeof groups)[number]['rows'][number];
    const rows = groups.flatMap((group) => group.rows);
    const shownRows = (): readonly Row[] =>
      rows.filter(({ item }) => !item.hidden);
    const rowOf = (target: EventTarget | null): Row | undefined => {
      const link = target instanceof Element ? target.closest('a') : null;
      return rows.find((row) => row.link === link);
    };

    // The selected row lives in the DOM: at most one link carries
    // `data-selected`, always a visible one.
    const selectedRow = (): Row | undefined =>
      rows.find(({ link }) => link.hasAttribute('data-selected'));
    const select = (row: Row | undefined): void => {
      rows.forEach(({ link }) => {
        link.toggleAttribute('data-selected', link === row?.link);
      });
    };

    // Hide every row the query misses, then every group left empty, and show
    // `no match` when no row is left. Returns the rows still shown.
    const applyFilter = (): readonly Row[] => {
      rows.forEach((row) => {
        row.item.hidden = !rowMatches(row.text, field.value);
      });
      groups.forEach(({ group, rows: groupRows }) => {
        group.hidden = groupRows.every(({ item }) => item.hidden);
      });
      const shown = shownRows();
      empty.hidden = shown.length > 0;
      return shown;
    };

    // An empty field, every row, and no selection: the start of every open,
    // and every close.
    const reset = (): void => {
      field.value = '';
      applyFilter();
      select(undefined);
      status.textContent = '';
    };

    // Every keystroke selects the first row left and says what Enter opens.
    field.addEventListener('input', () => {
      const shown = applyFilter();
      select(shown[0]);
      status.textContent = formatMatchCount(
        shown.length,
        field.value,
        shown[0]?.name ?? '',
      );
    });

    // Focus entering the field with nothing selected selects the first row,
    // so an open that focuses the field starts on it.
    field.addEventListener('focus', () => {
      if (selectedRow() === undefined) select(shownRows()[0]);
    });

    // Focus landing on a row selects it.
    list.addEventListener('focusin', (event) => {
      const row = rowOf(event.target);
      if (row !== undefined) select(row);
    });

    // A mouse that moves over a row selects it. Browsers also fire moves when
    // rows filter out or the list scrolls under a still mouse; those keep
    // their coordinates, so they change nothing. Focus stays in the field, and
    // follows the mouse when it was on another row, so the highlight and
    // Enter never point at different rows.
    let lastMove = '';
    list.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const at = `${String(event.clientX)} ${String(event.clientY)}`;
      if (at === lastMove) return;
      lastMove = at;
      const row = rowOf(event.target);
      if (row === undefined) return;
      select(row);
      if (rowOf(document.activeElement) !== undefined)
        row.link.focus({ preventScroll: true });
    });

    // A keyboard is there for the shortcut and on a fine pointer; on touch the
    // dialog keeps focus on `close`, so no on screen keyboard opens.
    const finePointer = (): boolean => matchMedia('(pointer: fine)').matches;

    // Whether the open that `toggle` reports was the script's own.
    let openedByScript = false;

    const open = (focusField: boolean): void => {
      if (dialog.open) return;
      openedByScript = true;
      reset();
      dialog.showModal();
      if (focusField) field.focus();
    };

    // An invoker button opens the dialog without the script: run the same
    // open steps once the browser has. `toggle` fires a frame after any open,
    // so an open the script made itself is skipped there; running its steps
    // again would wipe what was typed since and pull focus back to the field.
    dialog.addEventListener('toggle', (event) => {
      const byScript = openedByScript;
      openedByScript = false;
      if (event.newState !== 'open' || byScript) return;
      reset();
      if (finePointer()) field.focus();
    });
    // The browser fires `close` a task after the dialog closes, so a quick
    // reopen can come first; reset only a dialog that is still closed, or the
    // late event would wipe the new open's field and selection.
    dialog.addEventListener('close', () => {
      if (!dialog.open) reset();
    });

    // Where invoker commands are missing, the script wires the buttons itself.
    if (!('commandForElement' in HTMLButtonElement.prototype)) {
      document
        .querySelectorAll<HTMLButtonElement>(
          `button[commandfor="${COMMAND_MENU_ID}"]`,
        )
        .forEach((button) => {
          button.addEventListener('click', () => {
            const command = button.getAttribute('command');
            if (command === 'show-modal') open(finePointer());
            if (command === 'close') dialog.close();
          });
        });
    }

    document.addEventListener('keydown', (event) => {
      if (!isMenuShortcut(event)) return;
      event.preventDefault();
      if (dialog.open) dialog.close();
      else open(true);
    });

    dialog.addEventListener('keydown', (event) => {
      const { key, target } = event;
      const shown = shownRows();
      const index = shown.findIndex(({ link }) => link === target);

      if (key === 'ArrowDown' || key === 'ArrowUp') {
        if (target === closeButton) {
          if (key === 'ArrowDown') {
            event.preventDefault();
            field.focus();
          }
          return;
        }
        if (target !== field && index === -1) return;
        event.preventDefault();
        const selected = shown.findIndex(
          ({ link }) => link === selectedRow()?.link,
        );
        const next = nextFocus(
          target === field ? -1 : index,
          selected,
          shown.length,
          key,
        );
        (shown[next]?.link ?? field).focus();
        return;
      }

      // Enter follows the selected row exactly as a click does.
      if (key === 'Enter' && target === field) {
        if (!isComposingKey(event)) selectedRow()?.link.click();
        return;
      }

      // A letter typed on a row lands in the field.
      if (
        index !== -1 &&
        key.length === 1 &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey
      )
        field.focus();
    });

    // A plain activation closes the menu, then the link runs; a modified
    // click opens the link where the visitor asked and keeps the menu open.
    list.addEventListener('click', (event) => {
      if (
        event.button !== 0 ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      if (rowOf(event.target) !== undefined) dialog.close();
    });

    // A click on the dimmed page closes the menu. A backdrop click targets
    // the dialog itself, while a click on the panel targets a child; the
    // press must land there too, so a text selection dragged from the field
    // out to the page keeps the menu open. The press is heard on the
    // document: iOS Safari sends a touch only inside the box of an element
    // that listens for it, and the backdrop lies outside the dialog's box.
    let pressedOutside = false;
    document.addEventListener(
      'pointerdown',
      (event) => {
        pressedOutside = event.target === dialog;
      },
      { passive: true },
    );
    dialog.addEventListener('click', (event) => {
      if (pressedOutside && event.target === dialog) dialog.close();
    });

    filter.hidden = false;
    document.querySelectorAll('[data-shortcut-hint]').forEach((hint) => {
      hint.textContent = shortcutHint(navigator.platform);
    });
  };

  const dialog = document.getElementById(COMMAND_MENU_ID);
  if (dialog instanceof HTMLDialogElement) bind(dialog);
</script>
