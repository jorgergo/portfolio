---
import { COMMAND_MENU_ID } from '@/lib/command-menu';
import { getCv } from '@/lib/cv';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Spec 0003 lets the footer read the CV itself so the layout stays dumb and the
// 404 page gets the same footer; Astro serves the second call from memory.
const { basics } = await getCv();
const { city, countryCode } = basics.location;

// The UTC year of the build; the site is rebuilt on every push.
const year = new Date().getUTCFullYear();

// routePattern, not the pathname: with `build.format: 'file'` the home page's
// pathname is `/index.html` during the build.
const showHome = Astro.routePattern !== '/';

// Spec 0014: the command menu's button on a computer; a touch screen gets the
// corner button in BaseLayout instead. The script writes `cmd k` or `ctrl k`
// into the hint, which stays out of the button's name (`menu`), so the keys
// reach a screen reader through aria-keyshortcuts.
---

<footer
  class:list={[
    'mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-4 text-xs text-muted',
    className,
  ]}
>
  {showHome && (
    <a
      href="/"
      class="inline-flex min-h-6 items-center gap-2 transition-colors hover:text-accent-warm focus-visible:text-accent-warm print:hidden"
    >
      <span aria-hidden="true">←</span> home
    </a>
  )}
  <button
    type="button"
    commandfor={COMMAND_MENU_ID}
    command="show-modal"
    aria-keyshortcuts="Meta+K Control+K"
    class="inline-flex min-h-6 cursor-pointer items-center gap-2 transition-colors hover:text-accent-warm focus-visible:text-accent-warm pointer-coarse:hidden print:hidden"
  >
    menu{' '}
    <span
      aria-hidden="true"
      class="text-muted empty:hidden"
      data-shortcut-hint
    ></span>
  </button>
  <span class="ml-auto">
    {city}, {countryCode} · {year}
  </span>
</footer>
