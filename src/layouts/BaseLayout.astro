---
import '@/styles/global.css';
import css from '@/styles/global.css?raw';
import { Font } from 'astro:assets';
import SiteFooter from '@/components/SiteFooter.astro';
import SkipLink from '@/components/SkipLink.astro';
import { parseColorTokens } from '@/lib/contrast';
import {
  OG_TYPE,
  SHARE_IMAGE,
  TWITTER_CARD,
  type ShareMeta,
} from '@/lib/site-meta';

interface Props {
  title: string;
  description: string;
  // The canonical and share tags, from pageMeta (spec 0006). The 404 page and
  // the style guide pass none and get none.
  share?: ShareMeta | undefined;
  // false hides the footer on paper (the CV page, spec 0005); every other page
  // keeps its city line in print (spec 0003).
  printFooter?: boolean;
}

const { title, description, share, printFooter = true } = Astro.props;

// The palette has one source: the theme-color metas are read from global.css,
// never written by hand (spec 0003).
const { light, dark } = parseColorTokens(css);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {light.bg !== undefined && (
      <meta
        name="theme-color"
        media="(prefers-color-scheme: light)"
        content={light.bg}
      />
    )}
    {dark.bg !== undefined && (
      <meta
        name="theme-color"
        media="(prefers-color-scheme: dark)"
        content={dark.bg}
      />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    {share !== undefined && (
      <>
        <link rel="canonical" href={share.url} />
        <meta property="og:type" content={OG_TYPE} />
        <meta property="og:site_name" content={share.siteName} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={share.url} />
        <meta property="og:image" content={share.image.url} />
        <meta property="og:image:type" content={SHARE_IMAGE.type} />
        <meta property="og:image:width" content={String(share.image.width)} />
        <meta property="og:image:height" content={String(share.image.height)} />
        <meta property="og:image:alt" content={share.image.alt} />
        <meta name="twitter:card" content={TWITTER_CARD} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-plex-sans" />
  </head>
  <body class="flex min-h-dvh flex-col print:min-h-0">
    <SkipLink />
    <div class="mx-auto flex w-full max-w-content flex-1 flex-col gap-14 px-6 pt-10 pb-20 print:p-0">
      <main
        id="main"
        tabindex="-1"
        class="flex flex-col gap-14 focus-visible:outline-none"
      >
        <slot />
      </main>
      <SiteFooter class={printFooter ? undefined : 'print:hidden'} />
    </div>
  </body>
</html>
